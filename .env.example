# Firebase (Authentication — Email/Password + Google)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth (for "Continue with Google"). Create OAuth client IDs in the
# Google Cloud console and enable the Google provider in Firebase Auth.
# The Web client id is required; iOS/Android are only needed for a dev build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# FarmSquare API (Cloudflare Worker proxying WooCommerce; see worker/).
# WooCommerce consumer keys live in Worker secrets (worker/.dev.vars locally),
# never in the app.
EXPO_PUBLIC_API_URL=https://farmsquare-api.farmsquare.workers.dev

# Paystack (card checkout). Use your PUBLIC key only (pk_test_… / pk_live_…).
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
